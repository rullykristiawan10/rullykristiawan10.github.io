{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://www.mitraclima.co.id/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://www.mitraclima.co.id/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
